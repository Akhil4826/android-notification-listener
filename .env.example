# ==============================================================================
# Phone Reader - Environment Variable Configuration Template
# Copy this file to .env when running or testing locally.
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Backend API Authentication
# Strong secret token shared between your Android phone and the backend.
API_TOKEN=your-strong-random-bearer-token-here

# Target Device ID (matches the Device ID displayed in the Android App Settings screen)
DEVICE_ID=your-device-uuid-or-name

# Backend Service URL (for local testing or external deployment)
BACKEND_URL=https://your-api-gateway-id.execute-api.ap-south-1.amazonaws.com

# DynamoDB Table Name (defaults to PhoneReaderNotifications in production)
TABLE_NAME=PhoneReaderNotifications

# AWS Deployment Region (e.g. ap-south-1 for Mumbai, us-east-1 for N. Virginia)
AWS_REGION=ap-south-1

# Notification Retention (in days, after which DynamoDB automatically deletes records via TTL)
RETENTION_DAYS=7

# Privacy Mode: if true, Alexa announces app names without reading message contents aloud
PRIVACY_MODE=false

# Testing mode (true disables AWS network calls and uses local in-memory mock store)
USE_MOCK_DB=false
